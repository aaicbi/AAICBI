# Copy to .env and fill in real values. Never commit .env.

# Postgres — matches docker-compose.yml by default
DATABASE_URL="postgresql://cbt:cbt@localhost:5432/cbt_platform"

# Session signing — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Anthropic API key, used by src/lib/ai/extractQuestions.ts to structure
# imported DOCX content into questions. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Max upload size for DOCX imports, in bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760

# M11 — optional. Voyage AI API key, used by src/lib/embeddings.ts to
# flag likely-duplicate questions when an instructor uploads into a
# module's bank. Get one at https://dashboard.voyageai.com — costs
# roughly $0.02 per 1M tokens (a 60-question import is a fraction of a
# cent), charged once per import, never per trainee attempt. Leave this
# unset to skip duplicate detection entirely; nothing else in the
# platform requires it. See embeddings.ts for the full reasoning.
VOYAGE_API_KEY=""

# M14 — email notifications (welcome, password reset, module unlocked,
# assessment result). Get a key at https://resend.com — the free tier
# (3,000 emails/month) covers a single training org's cohort sizes
# comfortably. Leave unset to skip email sending entirely; every route
# that would send one degrades gracefully (the underlying action —
# registration, password reset, grading — always completes regardless).
# See src/lib/notifications/email.ts for the full provider reasoning.
RESEND_API_KEY=""

# M14 — the "from" address emails are sent as. Needs a domain verified
# in Resend's dashboard to send as your own domain (e.g.
# "AAICBI <noreply@aaicbi.africa>"); until then, falls back to Resend's
# shared onboarding@resend.dev sender, which works for testing but will
# look like a test sender to real recipients.
EMAIL_FROM=""

# M14 — the absolute base URL notification emails link back to (verify,
# reset password, course/module links) — email clients have no "current
# app" the way a browser tab does, so these can't be relative paths.
# Falls back to http://localhost:3000 if unset. Set this to your real
# deployed URL (e.g. "https://lms.aaicbi.africa") before sending real
# email to real trainees.
APP_URL=""

# M14 — WhatsApp notifications. NOT implemented yet — see
# src/lib/notifications/whatsapp.ts for why (Meta/WhatsApp Business API
# approval is a real-world process that can't happen inside a coding
# session). Leave this unset/false; setting it to "true" without a real
# provider implementation will make notifications fail loudly rather
# than pretend to send something that doesn't exist.
WHATSAPP_ENABLED="false"

# M42 — Google Cloud Translation API key, used by src/lib/translations.ts
# to draft Yoruba/Igbo/Hausa/French translations for the admin review
# screen at /admin/translations. Get one at console.cloud.google.com
# (enable the Cloud Translation API, then create an API key). Nigerian
# Pidgin is NOT supported by Google's API — drafted by Claude instead,
# using ANTHROPIC_API_KEY above. Leave this unset to skip the
# Google-Translate-backed languages entirely; Pidgin drafting still
# works without it.
GOOGLE_TRANSLATE_API_KEY=""

# M44 — Vercel Blob storage, used by src/lib/avatar.ts for real profile
# picture uploads (trainee and staff). This is provisioned, not typed
# in by hand: in your Vercel project, go to Storage → Create → Blob,
# and BLOB_READ_WRITE_TOKEN is added to your environment automatically.
# Locally, `vercel env pull` after creating the store will fetch it into
# your .env for you. Leave unset to develop without avatar uploads —
# every other feature works without it.
BLOB_READ_WRITE_TOKEN=""

# M25 — the account's real Paystack secret key. Two separate uses:
# verifying that an incoming webhook genuinely came from Paystack
# (src/lib/paystack/verifySignature.ts — HMAC-SHA512 of the raw
# request body, keyed with this exact value, not a separate "webhook
# secret"), and authenticating the server-to-server call to Paystack's
# own /transaction/verify endpoint (src/lib/paystack/client.ts) that
# happens before this app ever grants access for a payment. Get this
# from your Paystack dashboard — Settings → API Keys & Webhooks. Use
# your TEST secret key while developing; switching to LIVE is a real,
# deliberate decision for when this goes to production, not something
# to do by accident. Also register the webhook URL itself in that same
# dashboard page — test and live modes have separate webhook URLs, so
# both need configuring, not just one.
PAYSTACK_SECRET_KEY=""
